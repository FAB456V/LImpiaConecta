generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRABAJADOR
  CONDUCTOR
}

enum RequestStatus {
  PENDIENTE
  ACEPTADA
  EN_CURSO
  FINALIZADA
  RECHAZADA
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  role Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workerProfile WorkerProfile?
  services Service[]
  driverRequests ServiceRequest[] @relation("DriverRequests")
  workerRequests ServiceRequest[] @relation("WorkerRequests")
}

model WorkerProfile {
  id String @id @default(uuid())
  userId String @unique
  bio String?
  phone String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id String @id @default(uuid())
  workerId String
  title String
  description String
  price Decimal @db.Decimal(10,2)
  zone String
  safePoint String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  worker User @relation(fields: [workerId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]
  @@index([zone, active])
}

model ServiceRequest {
  id String @id @default(uuid())
  serviceId String
  driverId String
  workerId String
  scheduledAt DateTime
  status RequestStatus @default(PENDIENTE)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  driver User @relation("DriverRequests", fields: [driverId], references: [id], onDelete: Restrict)
  worker User @relation("WorkerRequests", fields: [workerId], references: [id], onDelete: Restrict)
  payment Payment?
  @@index([workerId, scheduledAt])
  @@index([driverId])
}

model Payment {
  id String @id @default(uuid())
  requestId String @unique
  amount Decimal @db.Decimal(10,2)
  paidAt DateTime @default(now())
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
}
